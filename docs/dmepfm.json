{"version":3,"kind":"Notebook","sha256":"b6ae13ca07bb2f93b358b58e064a7c8f0b2339a55c2ef1d2995f02660a4655c7","slug":"dmepfm","location":"/content/05_3dMEPFM.md","dependencies":[],"frontmatter":{"title":"Model-free deconvolution with pySPFM","kernelspec":{"name":"python3","display_name":"Python 3","language":"python"},"jupytext":{"text_representation":{"extension":".md","format_name":"myst","jupytext_version":"1.18.1"}},"content_includes_title":false,"authors":[{"nameParsed":{"literal":"The tedana community","given":"The","non_dropping_particle":"tedana","family":"community"},"name":"The tedana community","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/ME-ICA/multi-echo-data-analysis","copyright":"2021","numbering":{"title":{"offset":1}},"source_url":"https://github.com/ME-ICA/multi-echo-data-analysis/blob/main/content/05_3dMEPFM.md","edit_url":"https://github.com/ME-ICA/multi-echo-data-analysis/edit/main/content/05_3dMEPFM.md","exports":[{"format":"md","filename":"05_3dMEPFM.md","url":"/multi-echo-data-analysis/build/05_3dMEPFM-7c57729bb17da322fb5e3c5b9045bf32.md"}]},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import json\nimport os\nfrom glob import glob\n\nimport numpy as np\nfrom book_utils import load_pafin\nfrom nilearn.maskers import NiftiMasker\n\ndata_path = os.path.abspath('../data')","key":"iH3A5HpOvk"},{"type":"outputs","id":"UBo5RcrZagDWU-cf6urpn","children":[],"key":"psIMIM9HUH"}],"key":"nriWQGRkKz"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"raise ValueError(\"SKIP\")\ndata = load_pafin(data_path)\nout_dir = os.path.join(data_path, \"pySPFM\")","key":"pNJP95bLL4"},{"type":"outputs","id":"YZP9nIiT_TYri0TrqSqox","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"error","traceback":"\u001b[0;31m---------------------------------------------------------------------------\u001b[0m\n\u001b[0;31mValueError\u001b[0m                                Traceback (most recent call last)\nCell \u001b[0;32mIn[2], line 1\u001b[0m\n\u001b[0;32m----> 1\u001b[0m \u001b[38;5;28;01mraise\u001b[39;00m \u001b[38;5;167;01mValueError\u001b[39;00m(\u001b[38;5;124m\"\u001b[39m\u001b[38;5;124mSKIP\u001b[39m\u001b[38;5;124m\"\u001b[39m)\n\u001b[1;32m      2\u001b[0m data \u001b[38;5;241m=\u001b[39m load_pafin(data_path)\n\u001b[1;32m      3\u001b[0m out_dir \u001b[38;5;241m=\u001b[39m os\u001b[38;5;241m.\u001b[39mpath\u001b[38;5;241m.\u001b[39mjoin(data_path, \u001b[38;5;124m\"\u001b[39m\u001b[38;5;124mpySPFM\u001b[39m\u001b[38;5;124m\"\u001b[39m)\n\n\u001b[0;31mValueError\u001b[0m: SKIP","ename":"ValueError","evalue":"SKIP"},"key":"XdN8uAANhc"}],"key":"IDEko3pqH9"}],"key":"YZ1bviajBe"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pySPFM import SparseDeconvolution\n\n# Create masker to convert 4D NIfTI data to 2D array\nmasker = NiftiMasker(mask_img=data['mask'])\n\n# Fit masker once on a representative image (first echo)\nmasker.fit(data['echo_files'][0])\n\n# Load and mask each echo, then concatenate along the time axis\n# For multi-echo data, each echo's data (shape: n_timepoints × n_voxels) are stacked sequentially\nmasked_data = []\nfor f in data['echo_files']:\n    echo_data = masker.transform(f)  # Shape: (n_timepoints, n_voxels)\n    masked_data.append(echo_data)\n\nX = np.vstack(masked_data)  # Shape: (n_echoes * n_timepoints, n_voxels)\n\n# Fit the sparse deconvolution model\nmodel = SparseDeconvolution(\n    tr=2.47,\n    te=data['echo_times'],\n    criterion=\"bic\",\n    n_jobs=-1,  # Use all available CPU cores\n)\nmodel.fit(X)\n\n# Get the deconvolved activity-inducing signals\n# Note: coef_ has shape (n_timepoints, n_voxels) - the model recovers\n# the underlying neural activity at the original temporal resolution\nactivity = model.coef_\n\n# Transform back to NIfTI image and save\nos.makedirs(out_dir, exist_ok=True)\nactivity_img = masker.inverse_transform(activity)\nactivity_img.to_filename(os.path.join(out_dir, \"out_activity.nii.gz\"))\n\n# Also save the regularization parameter values\nnp.save(os.path.join(out_dir, \"out_lambda.npy\"), model.lambda_)\n\nprint(f\"Activity shape: {activity.shape}\")\nprint(f\"Saved activity to: {os.path.join(out_dir, 'out_activity.nii.gz')}\")","visibility":"show","key":"SSvpTwSqsH"},{"type":"outputs","id":"g1To_SB5PdJGqX1KQeNXx","children":[],"visibility":"show","key":"rwVhxhoxta"}],"data":{"tags":["output_scroll"]},"visibility":"show","key":"sgquhTeQzp"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"text","value":"The ","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"qtiqWhzepw"},{"type":"inlineCode","value":"SparseDeconvolution","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"TBG5FVfOko"},{"type":"text","value":" model provides several useful attributes and methods after fitting:","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"pzOHNaDu90"}],"key":"acVseyuFLr"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":81,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"coef_","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"cUT4de2oxc"},{"type":"text","value":": The deconvolved activity-inducing signals (shape: n_timepoints × n_voxels)","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"F9JSKNRgT4"}],"key":"PXFZCYi0s3"}],"key":"qCIclwDR0x"},{"type":"listItem","spread":true,"position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"lambda_","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"BMIq2w2mdA"},{"type":"text","value":": The regularization parameter values","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"lcD0shYQOR"}],"key":"q2QouX1RJI"}],"key":"ohDByPYEZu"},{"type":"listItem","spread":true,"position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"hrf_matrix_","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"tVwPlTDMmM"},{"type":"text","value":": The HRF convolution matrix used","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"SjwOlVKEcD"}],"key":"ndZJ2bwtGt"}],"key":"OIHy6oEnkd"},{"type":"listItem","spread":true,"position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"get_fitted_signal()","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"g0Vz41GZr0"},{"type":"text","value":": Returns the fitted (reconstructed) signal; takes no arguments","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"BeBPi3luWu"}],"key":"uikSskNu7S"}],"key":"tvI3dTCx65"},{"type":"listItem","spread":true,"position":{"start":{"line":85,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"get_residuals(X)","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"r6kGv0u5DG"},{"type":"text","value":": Returns the residuals between the original data and fitted signal; requires the input data ","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"ZsxkttAwEW"},{"type":"inlineCode","value":"X","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"DqsPLOwnrX"},{"type":"text","value":" as an argument","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"qVqZlFDFFO"}],"key":"mRYiwKz4uM"}],"key":"geplw51SNg"}],"key":"yDAZmMhf2y"}],"key":"L8SQNFZkZo"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Get the fitted signal and residuals\n# Note: These have shape (n_echoes * n_timepoints, n_voxels) matching the input X\nfitted_signal = model.get_fitted_signal()\nresiduals = model.get_residuals(X)\n\n# Save the fitted signal and residuals as numpy arrays\n# (shape doesn't match single-echo masker expectations for NIfTI output)\nnp.save(os.path.join(out_dir, \"out_fitted.npy\"), fitted_signal)\nnp.save(os.path.join(out_dir, \"out_residuals.npy\"), residuals)\n\nprint(f\"Fitted signal shape: {fitted_signal.shape}\")\nprint(f\"Residuals shape: {residuals.shape}\")","key":"lTAOt7nVfp"},{"type":"outputs","id":"CNTmtuB7KXI7rKih3ulYo","children":[],"key":"jnTD1AjXct"}],"key":"UMUtzkLncu"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"children":[{"type":"text","value":"The pySPFM workflow writes out a number of files.","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"QESaXZe2xq"}],"key":"tQchxZSg0M"}],"key":"YuxRu0FdrW"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"out_files = sorted(glob(os.path.join(out_dir, \"*\")))\nout_files = [os.path.basename(f) for f in out_files]\nprint(\"\\n\".join(out_files))","key":"IahmoY4A4T"},{"type":"outputs","id":"a4Rd4jhsc3zfYtDyvpSAh","children":[],"key":"af0rJTuMMQ"}],"key":"OBxeXJx45I"}],"key":"HgoN4iFiqT"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Dual-Echo Denoising with nilearn","url":"/dual-echo-denoising","group":"Analysis Tutorials"},"next":{"title":"Cerebrovascular Reactivity 