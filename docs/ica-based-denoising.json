{"version":3,"kind":"Notebook","sha256":"7d2bcb92dc26ebf953da27c25ec686dc08d24a51d773934956f0c51b42c5c1ad","slug":"ica-based-denoising","location":"/content/08_ICA_Based_Denoising.md","dependencies":[],"frontmatter":{"title":"Denoising Data with ICA","kernelspec":{"name":"python3","display_name":"Python 3","language":"python"},"jupytext":{"text_representation":{"extension":".md","format_name":"myst","jupytext_version":"1.18.1"}},"content_includes_title":false,"authors":[{"nameParsed":{"literal":"The tedana community","given":"The","non_dropping_particle":"tedana","family":"community"},"name":"The tedana community","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/ME-ICA/multi-echo-data-analysis","copyright":"2021","numbering":{"title":{"offset":1}},"source_url":"https://github.com/ME-ICA/multi-echo-data-analysis/blob/main/content/08_ICA_Based_Denoising.md","edit_url":"https://github.com/ME-ICA/multi-echo-data-analysis/edit/main/content/08_ICA_Based_Denoising.md","exports":[{"format":"md","filename":"08_ICA_Based_Denoising.md","url":"/multi-echo-data-analysis/build/08_ICA_Based_Denoisi-f21073c33d293e06b8ba4c37aee7b0f8.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"ICA classification methods like ","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"gUE3CefM4S"},{"type":"inlineCode","value":"tedana","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"QJ6gHzLCcH"},{"type":"text","value":" will produce two important outputs: component time series and component classifications.\nThe component classifications will indicate whether each component is “good” (accepted) or “bad” (rejected).\nTo remove noise from your data, you can regress the “bad” components out of it, though there are multiple methods to accomplish this.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"nXT228EWTZ"}],"key":"SjeWNcYYCR"},{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"Let’s start by loading the necessary data.","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"Cahxdyxjr9"}],"key":"Bcb550OtWR"},{"type":"tabSet","children":[{"type":"tabItem","title":"Python","children":[{"type":"code","lang":"python","value":"import numpy as np\nimport pandas as pd\nfrom nilearn import masking\n\n# For this, you need the mixing matrix, the data you're denoising,\n# a brain mask, and an index of \"bad\" components\ndata_file = \"preprocessed_data.nii.gz\"\nmixing_file = \"mixing.tsv\"\ndata['mask'] = \"mask.nii.gz\"\nden_idx = np.array([0, 1, 2, 3, 4, 5])\n\n# Load the mixing matrix\nmixing_df = pd.read_table(mixing_file, index_col=\"component\")\nmixing = mixing_df.data\n\n# Apply the mask to the data image to get a 2d array\narr = masking.apply_mask(data_file, data['mask'])\n\n# Transpose to voxels-by-time\narr = arr.T\n\n# The first dimension should be time\nassert arr.shape[1] == mixing.shape[0]","position":{"start":{"line":23,"column":1},"end":{"line":47,"column":1}},"key":"GNmlDRa53G"}],"key":"uxiUCvKfq5"},{"type":"tabItem","title":"FSL","children":[{"type":"code","lang":"bash","value":"data_file=preprocessed_data.nii.gz\nmixing_file=mixing.tsv\nmask_file=mask.nii.gz\nden_idx=(0, 1, 2, 3, 4, 5)","position":{"start":{"line":50,"column":1},"end":{"line":55,"column":1}},"key":"ihCKofu7pG"}],"key":"jlXKBMkFTq"},{"type":"tabItem","title":"AFNI","children":[{"type":"code","lang":"bash","value":"data_file=preprocessed_data.nii.gz\nmixing_file=mixing.tsv\nmask_file=mask.nii.gz\nden_idx=(0, 1, 2, 3, 4, 5)","position":{"start":{"line":58,"column":1},"end":{"line":63,"column":1}},"key":"yIj4mudieL"}],"key":"mDKewGOYtc"}],"key":"gkpVGo7wko"},{"type":"heading","depth":2,"position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"children":[{"type":"text","value":"Aggressive Denoising","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"nsEybmyBzD"}],"identifier":"aggressive-denoising","label":"Aggressive Denoising","html_id":"aggressive-denoising","implicit":true,"key":"g4a13ORJBG"},{"type":"paragraph","position":{"start":{"line":69,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"text","value":"If you regress just nuisance regressors (i.e., rejected components) out of your data,\nthen retain the residuals for further analysis, you are doing aggressive denoising.","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"key":"OuQ95kHsMH"}],"key":"sSEDPlbpvm"},{"type":"tabSet","children":[{"type":"tabItem","title":"Python","children":[{"type":"code","lang":"python","value":"# Fit GLM to bad components only\nbetas = np.linalg.lstsq(motion_components, arr, rcond=None)[0]\n\n# Denoise the data with the bad components\npred_arr = np.dot(motion_components, betas)\narr_denoised = arr - pred_arr\n\n# Save to file\nimg_denoised = masking.unmask(arr_denoised.T, data['mask'])\nimg_denoised.to_filename(\"denoised.nii.gz\")","position":{"start":{"line":74,"column":1},"end":{"line":85,"column":1}},"key":"fwylgcp7kC"}],"key":"RhThe23yFU"},{"type":"tabItem","title":"FSL","children":[{"type":"code","lang":"bash","value":"3dcalc --input stuff","position":{"start":{"line":88,"column":1},"end":{"line":90,"column":1}},"key":"xYCHd8d06G"}],"key":"dG5SJd9U38"},{"type":"tabItem","title":"AFNI","children":[{"type":"code","lang":"bash","value":"3dcalc --input stuff","position":{"start":{"line":93,"column":1},"end":{"line":95,"column":1}},"key":"XVmpZRNabk"}],"key":"NXm8wEKkkU"}],"key":"bR7T9ZsF1E"},{"type":"heading","depth":2,"position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"children":[{"type":"text","value":"Non-Aggressive Denoising","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"key":"FmLjIO067x"}],"identifier":"non-aggressive-denoising","label":"Non-Aggressive Denoising","html_id":"non-aggressive-denoising","implicit":true,"key":"lS7ttdLyle"},{"type":"paragraph","position":{"start":{"line":101,"column":1},"end":{"line":102,"column":1}},"children":[{"type":"text","value":"If you include both nuisance regressors and regressors of interest in your regression,\nyou are doing nonaggressive denoising.","position":{"start":{"line":101,"column":1},"end":{"line":101,"column":1}},"key":"LzQtdqcjA0"}],"key":"rnkPVXVIBG"},{"type":"tabSet","children":[{"type":"tabItem","title":"Python","children":[{"type":"code","lang":"python","value":"# Fit GLM to all components\nbetas = np.linalg.lstsq(mixing, arr, rcond=None)[0]\n\n# Denoise the data using the betas from just the bad components\npred_arr = np.dot(motion_components, betas[den_idx, :])\narr_denoised = arr - pred_arr\n\n# Save to file\nimg_denoised = masking.unmask(arr_denoised.T, data['mask'])\nimg_denoised.to_filename(\"denoised.nii.gz\")","position":{"start":{"line":106,"column":1},"end":{"line":117,"column":1}},"key":"PoBOyRwQhn"}],"key":"DHacjTRrPm"},{"type":"tabItem","title":"FSL","children":[{"type":"code","lang":"bash","value":"3dcalc --input stuff","position":{"start":{"line":120,"column":1},"end":{"line":122,"column":1}},"key":"qlNAHTLSak"}],"key":"aYtk9wpaaU"},{"type":"tabItem","title":"AFNI","children":[{"type":"code","lang":"bash","value":"3dcalc --input stuff","position":{"start":{"line":125,"column":1},"end":{"line":127,"column":1}},"key":"escCX9tYlt"}],"key":"LVTmcrgOfl"}],"key":"jfz57TAtJi"},{"type":"heading","depth":2,"position":{"start":{"line":131,"column":1},"end":{"line":131,"column":1}},"children":[{"type":"text","value":"Component orthogonalization","position":{"start":{"line":131,"column":1},"end":{"line":131,"column":1}},"key":"qhS6e3iRBJ"}],"identifier":"component-orthogonalization","label":"Component orthogonalization","html_id":"component-orthogonalization","implicit":true,"key":"LZDHmUVKi9"},{"type":"paragraph","position":{"start":{"line":133,"column":1},"end":{"line":137,"column":1}},"children":[{"type":"text","value":"Independent component analysis decomposes the data into ","position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"key":"nYBJhkPox5"},{"type":"emphasis","position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"children":[{"type":"text","value":"independent","position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"key":"VGFjHdPjMx"}],"key":"i4z80Z4UYC"},{"type":"text","value":" components, obviously.\nUnlike principal components analysis, the components from ICA are not orthogonal, so they may explain shared variance.\nIf you want to ensure that variance shared between the accepted and rejected components does not contaminate the denoised data,\nyou may wish to orthogonalize the rejected components with respect to the accepted components.\nThis way, you can regress the rejected components out of the data in the form of, what we call, “pure evil” components.","position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"key":"IuAcyjqZlm"}],"key":"QA5UXm3yYE"},{"type":"tabSet","children":[{"type":"tabItem","title":"Python","children":[{"type":"code","lang":"python","value":"good_idx = np.setdiff1d(np.arange(mixing.shape[1]), den_idx)\n\n# Separate the mixing matrix into \"good\" and \"bad\" components\nbad_mixing = mixing[:, den_idx]\ngood_mixing = mixing[:, good_idx]\n\n# Regress the good components out of the bad ones\nbetas = np.linalg.lstsq(good_mixing, bad_mixing, rcond=None)[0]\npred_bad_mixing = np.dot(good_mixing, betas)\north_motion_components = bad_mixing - pred_bad_mixing\n\n# Replace the old component time series in the mixing matrix with the new ones\nmixing[:, den_idx] = orth_motion_components","position":{"start":{"line":141,"column":1},"end":{"line":155,"column":1}},"key":"SezhgZJYan"}],"key":"QhBw0jR4gO"},{"type":"tabItem","title":"FSL","children":[{"type":"code","lang":"bash","value":"3dcalc --input stuff","position":{"start":{"line":158,"column":1},"end":{"line":160,"column":1}},"key":"phv4B9kX8s"}],"key":"azLPdYovQ5"},{"type":"tabItem","title":"AFNI","children":[{"type":"code","lang":"bash","value":"3dcalc --input stuff","position":{"start":{"line":163,"column":1},"end":{"line":165,"column":1}},"key":"vPg5np5Rru"}],"key":"FPCSwjQHqf"}],"key":"kUmtWBBqZQ"},{"type":"paragraph","position":{"start":{"line":169,"column":1},"end":{"line":169,"column":1}},"children":[{"type":"text","value":"Once you have these “pure evil” components, you can perform aggressive denoising on the data.","position":{"start":{"line":169,"column":1},"end":{"line":169,"column":1}},"key":"FxLIeqJn4h"}],"key":"csvPdIfZm3"},{"type":"tabSet","children":[{"type":"tabItem","title":"Python","children":[{"type":"code","lang":"python","value":"# Fit GLM to bad components only\nbetas = np.linalg.lstsq(orth_motion_components, arr, rcond=None)[0]\n\n# Denoise the data with the bad components\npred_arr = np.dot(orth_motion_components, betas)\narr_denoised = arr - pred_arr\n\n# Save to file\nimg_denoised = masking.unmask(arr_denoised.T, data['mask'])\nimg_denoised.to_filename(\"denoised.nii.gz\")","position":{"start":{"line":173,"column":1},"end":{"line":184,"column":1}},"key":"e9vt7Rza83"}],"key":"Ew1OBxGxfL"},{"type":"tabItem","title":"FSL","children":[{"type":"code","lang":"bash","value":"3dcalc --input stuff","position":{"start":{"line":187,"column":1},"end":{"line":189,"column":1}},"key":"Nvo1nt2xVw"}],"key":"zfX7qTbmMl"},{"type":"tabItem","title":"AFNI","children":[{"type":"code","lang":"bash","value":"3dcalc --input stuff","position":{"start":{"line":192,"column":1},"end":{"line":194,"column":1}},"key":"lYAwsKWlaS"}],"key":"t1nSL0G4HC"}],"key":"yHk6USAuLg"}],"key":"rS2WeOAO3j"}],"key":"bQNglmJOhw"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Manual Classification with rica","url":"/manual-classification-with-rica","group":"Analysis Tutorials"},"next":{"title":"Advanced Applications","url":"/advanced-applications","group":"Analysis Tutorials"}}},"domain":"http://localhost:3003"}